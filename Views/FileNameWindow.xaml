<Window x:Class="ChangeFileName.Views.FileNameWindow"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:ChangeFileName.Views" xmlns:local1="clr-namespace:ChangeFileName.ViewModels"
        mc:Ignorable="d" 
             FontSize="16"
             Height="490"
             Width="600"
             Title="Utilities tool - CSS VN Team @2025"
             ResizeMode="NoResize"
             WindowStartupLocation="CenterScreen"
             d:DesignHeight="490" d:DesignWidth="600" VerticalAlignment="Stretch"
        SizeToContent="Height">
    <Window.Resources>
        <local1:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <local1:UpperCaseConverter x:Key="UpperCaseConverter"/>
    </Window.Resources>
    <StackPanel Background="#FF3B4453" Orientation="Vertical">
        <Border Padding="10">
            <Grid>
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="auto"/>
                            <RowDefinition Height="auto"/>
                            <RowDefinition Height="auto"/>
                            <RowDefinition Height="auto"/>
                            <RowDefinition Height="auto"/>
                            <RowDefinition Height="auto"/>
                        </Grid.RowDefinitions>
                        <GroupBox Header="Update file name:" Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3"
                                  Padding="5" Foreground="White">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="auto"/>
                                    <ColumnDefinition Width="auto"/>
                                    <ColumnDefinition Width="auto"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="auto"/>
                                    <RowDefinition Height="auto"/>
                                </Grid.RowDefinitions>
                                <Label Grid.Row="0" Grid.Column="0" Content="Input file name"
                                       Foreground="White"/>
                                <TextBox Grid.Column="0" Grid.Row="1" Height="30" Width="350" Text="{Binding NewFileName, Mode=TwoWay}"/>
                                <Label Content="Revision" Grid.Row="0" Grid.Column="1" HorizontalContentAlignment="Center"
                                       Foreground="White"/>
                                <TextBox Grid.Column="1" Grid.Row="1"  Text="{Binding RevisionNumber}" 
                                         VerticalContentAlignment="Center" 
                                         HorizontalContentAlignment="Center" 
                                         HorizontalAlignment="Center" Width="50" Margin="15 0 15 0"/>
                                <Button Grid.Column="2" 
                                        Grid.Row="1" Width="80" Content="Update" 
                                        HorizontalAlignment="Right"
                                        Margin="30 0 0 0"
                                        Command="{Binding ChangeFileNameCommand}" 
                                        Background="OrangeRed" 
                                        Foreground="White"/>
                            </Grid>
                        </GroupBox>
                        <GroupBox Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3" 
                                  Header="Convert text to UPPER:"
                                  Padding="5"
                                  Foreground="White">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="auto"/>
                                    <ColumnDefinition Width="auto"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="auto"/>
                                    <RowDefinition Height="auto"/>
                                    <RowDefinition Height="auto"/>
                                </Grid.RowDefinitions>
                                <Label Grid.Column="0" Grid.Row="0" Content="Input text to convert:"
                                       Foreground="White"/>
                                <TextBox Grid.Column="0" Grid.Row="1" Height="30"
                                          Grid.ColumnSpan="3"                                       
                                         Text="{Binding InputText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                <TextBox Grid.Column="0" Grid.Row="5" Height="30" 
                                 Margin="0 10 0 0"  Grid.ColumnSpan="3"
                                 Text="{Binding InputText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource UpperCaseConverter}}"
                                 IsReadOnly="True"
                                 Foreground="Green"/>

                            </Grid>
                        </GroupBox>
                        <GroupBox Header="Upload file to S:\\... drive" Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3"
                                  Padding="5" Foreground="White">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="auto"/>
                                    <ColumnDefinition Width="auto"/>
                                    <ColumnDefinition Width="auto"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="auto"/>
                                    <RowDefinition Height="auto"/>
                                    <RowDefinition Height="auto"/>
                                    <RowDefinition Height="auto"/>
                                    <RowDefinition Height="auto"/>
                                </Grid.RowDefinitions>
                                <Label Grid.Row="0" Grid.Column="0" Content="Current local drive:"
                                       HorizontalAlignment="Left" Foreground="White"/>
                                <TextBox Grid.Row="1" Grid.Column="0" Height="30" Width="350"
                                         Text="{Binding CurrentLocalFilePath}" 
                                         IsReadOnly="True"
                                         Foreground="Green"/>
                                <Button Grid.Row="1" Grid.Column="1" Width="80" Margin="15 0 15 0" Content="Get"
                                        Command="{Binding GetCurrentLocalFileDwgCommand}"/>
                                <Label Grid.Row="2" Grid.Column="0" Content="S:\\..." Margin="0 5 0 0"
                                       HorizontalAlignment="Left" Foreground="White"/>
                                <TextBox Grid.Row="3" Grid.Column="0" Height="30"
                                         MaxWidth="350"
                                         Text="{Binding SDriveCompanyPath}"
                                         IsReadOnly="True"
                                         Foreground="Green"/>
                                <Button Grid.Row="3" Grid.Column="1" Width="80" Content="..." Command="{Binding GetSDriveProjectFolderCommand}"/>
                                <Button Grid.Row ="3" Grid.Column="2" Width="80" Content="Push" Background="OrangeRed" Foreground="White" 
                                        Command="{Binding PushFileToSDriveCommand}"/>
                                <Expander Grid.Row="4" Margin="0 10 0 0" Grid.Column="0" Grid.ColumnSpan="3"
                                          Header="Current folder" Foreground="White" IsExpanded="{Binding IsExpandedHistoryPath}">
                                    <ListView ItemsSource="{Binding FilePathToListView}"
                                              SelectedItem="{Binding SelectHistoryPath, Mode=TwoWay}"
                                              SelectionChanged="ListViewHistoryPath_SelectionChanged">
                                    </ListView>
                                </Expander>
                            </Grid>
                        </GroupBox>
                    </Grid>
                </StackPanel>
            </Grid>
        </Border>
    </StackPanel>
</Window>
